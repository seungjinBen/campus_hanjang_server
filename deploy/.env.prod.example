# ============================================================
# CampusHanjang 프로덕션 환경변수 — /home/ubuntu/app/.env 로 복사 후 값 채우기
# 이 example 파일만 커밋한다. 실제 .env는 절대 커밋 금지.
# ============================================================

SPRING_PROFILES_ACTIVE=prod

# --- DB: Supabase ---
# Supabase 대시보드 → Connect → "Session pooler" 문자열 사용 (Transaction pooler 6543 금지 — Hibernate prepared statement 충돌)
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.xxxxxxxxxxxx
DATABASE_PASSWORD=

# --- CORS ---
ALLOWED_ORIGINS=https://www.campushanjang.kr

# --- JWT — openssl rand -base64 64 ---
JWT_SECRET=

# --- 카카오 (developers.kakao.com 콘솔) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://www.campushanjang.kr/auth/kakao/callback

# --- Firebase — base64 -w0 firebase-key.json ---
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- 연락처 암호화 (AES-256-GCM, IV는 레코드별 랜덤 생성) — openssl rand -hex 32 ---
CONTACT_ENCRYPTION_KEY=

# --- 학생인증 AI 에이전트 ---
ANTHROPIC_API_KEY=

# --- 관리자 카카오 ID (본인 계정) ---
ADMIN_KAKAO_ID=4871940017

# --- 테스트 계정 화이트리스트 (쉼표 구분) — 비우면 prod에서 로컬 로그인 전면 차단 ---
LOCAL_LOGIN_ALLOWED_EMAILS=
